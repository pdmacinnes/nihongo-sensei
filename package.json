{
  "name": "nihongo-sensei",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "tsc && vite build && electron-builder"
  },
  "build": {
    "appId": "com.pdmacinnes.nihongosensei",
    "productName": "Nihongo Sensei",
    "icon": "public/icon-512.png",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.36.3",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "firebase": "^12.11.0",
    "framer-motion": "^11.3.24",
    "hanzi-writer": "^3.7.3",
    "hanzi-writer-data": "^2.0.1",
    "jszip": "^3.10.1",
    "kuromoji": "^0.1.2",
    "path-browserify": "^1.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^6.26.1",
    "sql.js": "^1.14.1",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/kuromoji": "^0.1.3",
    "@types/path-browserify": "^1.0.3",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.9",
    "typescript": "^5.5.3",
    "vite": "^5.4.2",
    "vite-plugin-pwa": "^1.2.0",
    "wait-on": "^8.0.1"
  }
}
